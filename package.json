{
  "name": "no-ai-act",
  "private": true,
  "version": "3.0.0",
  "description": "NO AI ACT — Simulatore di una società non regolata. Serious game investigativo sull'AI Act europeo.",
  "author": "Matteo Angeloni",
  "type": "module",
  "scripts": {
    "smoke:final-modes": "node scripts/smoke/final-modes-smoke.mjs",
    "smoke:final-routes": "node scripts/smoke/final-routes-smoke.mjs",
    "smoke:release-cases": "node scripts/smoke/release-cases-smoke.mjs",
    "smoke:release-pipeline": "node --import tsx scripts/smoke/release-analytics-pipeline.mjs",
    "smoke:release-a11y": "node scripts/smoke/release-a11y-smoke.mjs",
    "smoke:release-surprise": "node scripts/smoke/release-surprise-smoke.mjs",
    "insights:dev": "tsx analytics/local-server.ts",
    "insights:typecheck": "tsc --noEmit -p analytics/tsconfig.json",
    "insights:check": "node scripts/ci/check-insights-worker.mjs",
    "smoke:insights": "node scripts/smoke/insights-smoke.mjs",
    "smoke:insights-worker": "node scripts/smoke/insights-worker-smoke.mjs",
    "site:fr": "node scripts/site/sync-fr-inventory.mjs && node scripts/site/build-fr-pages.mjs",
    "smoke:fr": "node scripts/smoke/french-localization-smoke.mjs",
    "smoke:gameplay-ux": "node scripts/smoke/gameplay-ux-smoke.mjs",
    "smoke:mobile-ux": "node scripts/smoke/mobile-ux-smoke.mjs",
    "smoke:analytics": "node scripts/smoke/analytics-smoke.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && node scripts/copy-notices.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:metadata": "node scripts/ci/audit-metadata.mjs",
    "audit:seo": "node scripts/seo/audit-routes.mjs",
    "insight": "node scripts/seo/site-insight.mjs",
    "verify:dist": "node scripts/ci/verify-dist.mjs",
    "report:dist": "node scripts/ci/dist-report.mjs",
    "smoke:gameplay": "node scripts/smoke/gameplay-smoke.mjs",
    "smoke:keyboard": "node scripts/smoke/keyboard-smoke.mjs",
    "smoke:draft": "node scripts/smoke/draft-smoke.mjs",
    "smoke:privacy": "node scripts/smoke/privacy-smoke.mjs",
    "smoke:layout": "node scripts/smoke/layout-smoke.mjs",
    "smoke:audio": "node scripts/smoke/audio-smoke.mjs",
    "smoke:action-layer": "node scripts/smoke/action-layer-smoke.mjs",
    "smoke:inspector-desk": "node scripts/smoke/inspector-desk-smoke.mjs",
    "media:press": "node scripts/media/capture-press.mjs",
    "diag:density": "node scripts/diag/ui-density.mjs",
    "diag:case": "node scripts/diag/play-case.mjs",
    "smoke:press-pages": "node scripts/smoke/press-pages-smoke.mjs",
    "smoke:all": "node scripts/smoke/run-all.mjs",
    "smoke:visual-language": "node scripts/smoke/visual-language-smoke.mjs"
  },
  "license": "(GPL-3.0-or-later AND CC-BY-SA-4.0)",
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.2",
    "jose": "^6.2.12",
    "miniflare": "^5.20261006.2-beta",
    "parse5": "^8.0.1",
    "playwright": "^1.61.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.150.0"
  }
}
