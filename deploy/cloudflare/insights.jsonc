{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "no-ai-act-player-insights",
  "main": "../../analytics/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "insights.no-ai-act.eu", "custom_domain": true }
    // AFTER separate telemetry/privacy approval and beta DNS activation only:
    // ,{ "pattern": "beta.no-ai-act.eu/collect", "zone_name": "no-ai-act.eu" }
  ],
  "assets": { "directory": "../../analytics/dashboard", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false },
  "vars": {
    "COLLECTION_ENABLED": "false", "DATA_CLASSIFICATION": "observed",
    "ALLOWED_ORIGIN": "https://beta.no-ai-act.eu",
    "ADMIN_HOST": "insights.no-ai-act.eu", "COLLECTION_HOST": "beta.no-ai-act.eu"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "no-ai-act-player-insights", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../analytics/migrations" }],
  "ratelimits": [
    { "name": "INGEST_LIMITER", "namespace_id": "41001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "41002", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": { "crons": ["15 3 * * *"] }
}
