{
  "documentVersion": 2,
  "status": "review-draft",
  "asOf": "2026-10-30",
  "wireSchemaImplemented": 2,
  "wireSchemasAccepted": [1, 2],
  "wireSchema2Deployed": false,
  "authoritativeCode": "src/game/systems/analyticsSchema.ts",
  "commonProperties": {
    "language": { "required": true, "values": ["it", "en", "fr"], "meaning": "Selected game language." },
    "mode": { "required": true, "values": ["turno", "libera", "sorpresa", "ripasso"], "meaning": "Game mode at emission; not a participant attribute." },
    "phase": { "required": true, "values": ["menu", "briefing", "map", "case", "evidence", "incident", "decision", "report", "consequence", "norm", "archive", "glossary", "session_end", "finale", "learning", "credits"], "meaning": "Current supported game phase." },
    "caseId": { "required": false, "valuesSource": "PLAYABLE_CASES", "meaning": "Closed case identifier." },
    "result": { "required": false, "values": ["correct", "partial", "wrong"], "meaning": "Game-defined case result; not legal competence or learning efficacy." },
    "hintUsed": { "required": false, "type": "boolean", "meaning": "Whether a hint was used in the attempt." },
    "durationBucket": { "required": false, "values": ["under_1m", "1_to_5m", "5_to_15m", "15_to_30m", "30m_plus"], "meaning": "Monotonic elapsed-time bucket; may include inactivity." },
    "tutorialVersion": { "required": false, "values": ["investigation-v1"], "meaning": "Closed tutorial contract version." },
    "selectedClassification": { "required": false, "values": ["vietata", "alto_rischio", "trasparenza", "basso_rischio", "non_rilevante"], "meaning": "Closed selected classification; schema 2 only." },
    "referenceClassification": { "required": false, "values": ["vietata", "alto_rischio", "trasparenza", "basso_rischio", "non_rilevante"], "meaning": "Game reference classification; schema 2 only." },
    "classificationMatch": { "required": false, "type": "boolean", "meaning": "Selected and reference classification match; schema 2 only." },
    "selectedMeasure": { "required": false, "values": ["blocco", "oversight", "audit", "informare", "etichettare", "dati_logging", "nessuna"], "meaning": "Closed selected measure; schema 2 only." },
    "selectedActor": { "required": false, "values": ["provider", "deployer", "autorita", "responsabile_umano", "fornitore_esterno"], "meaning": "Closed selected actor; schema 2 only." },
    "evidenceQuality": { "required": false, "values": ["low", "medium", "high"], "meaning": "Game-derived bounded evidence band, not critical thinking or efficacy." },
    "decisionQuality": { "required": false, "values": ["low", "medium", "high"], "meaning": "Game-derived bounded decision band, not legal competence." },
    "reasoningQuality": { "required": false, "values": ["correct", "partial", "wrong"], "meaning": "Game-derived motivation grade; no free text transmitted." },
    "viewedEvidenceBand": { "required": false, "values": ["none", "one", "two", "three_plus"], "meaning": "Bounded count band." },
    "citedEvidenceBand": { "required": false, "values": ["none", "one", "two", "three_plus"], "meaning": "Bounded count band." },
    "omittedRelevantBand": { "required": false, "values": ["none", "one", "two", "three_plus"], "meaning": "Bounded count band." },
    "contradictoryEvidenceRecognized": { "required": false, "type": "boolean", "meaning": "Game-derived closed indicator." },
    "revisionOccurred": { "required": false, "type": "boolean", "meaning": "Whether a tracked revision occurred." },
    "revisionCountBand": { "required": false, "values": ["none", "one", "two", "three_plus"], "meaning": "Bounded revision count." },
    "revisionDirection": { "required": false, "values": ["none", "toward_reference", "away_from_reference", "lateral"], "meaning": "Change relative to game reference, not improvement in critical thinking." },
    "abandonmentPhase": { "required": false, "valuesSource": "PHASES", "meaning": "Observed phase when a case was left." },
    "accessibilitySetting": { "required": false, "values": ["reading_layer", "reduced_motion", "instant_text", "keyboard_navigation"], "meaning": "Closed accessibility feature category." },
    "errorCode": { "required": false, "values": ["render", "audio", "storage", "analytics_transport", "unexpected"], "meaning": "Closed technical error category without message or stack." }
  },
  "publicAggregate": {
    "events": ["game_opened", "game_started", "game_resumed", "usage_case_completed", "usage_case_left", "usage_session_completed", "pageview", "case_quality_assessed", "decision_revised", "accessibility_used", "interface_error"],
    "properties": ["language", "mode", "phase", "caseId", "selectedClassification", "referenceClassification", "classificationMatch", "selectedMeasure", "selectedActor", "evidenceQuality", "decisionQuality", "reasoningQuality", "viewedEvidenceBand", "citedEvidenceBand", "omittedRelevantBand", "contradictoryEvidenceRecognized", "revisionOccurred", "revisionCountBand", "revisionDirection", "accessibilitySetting", "errorCode"],
    "excludes": ["free-text answers", "evidence content and indexes", "report text", "numeric scores", "precise action counts", "player identifiers", "research responses"]
  },
  "events": {
    "game_opened": { "cardinality": "once/document", "required": [], "meaning": "Runtime opened; not a unique person or session." },
    "game_started": { "cardinality": "once/session", "required": [], "meaning": "New observed play period started." },
    "game_resumed": { "cardinality": "once/session", "required": [], "meaning": "Saved play resumed." },
    "usage_case_completed": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Public-subset case completion without outcome or duration." },
    "usage_case_left": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Public-subset observed case exit." },
    "usage_session_completed": { "cardinality": "once/session", "required": [], "meaning": "Public-subset plan completion." },
    "game_session_ended": { "cardinality": "once/session", "required": ["durationBucket"], "meaning": "Observed end trigger; browser termination can be lost." },
    "language_selected": { "cardinality": "action", "required": [], "meaning": "Language selection changed." },
    "mode_selected": { "cardinality": "action", "required": [], "meaning": "Mode selection changed." },
    "case_started": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Case attempt started." },
    "case_completed": { "cardinality": "once/case", "required": ["caseId", "result", "durationBucket", "hintUsed"], "meaning": "Case reached completion in the game model." },
    "case_abandoned": { "cardinality": "once/case", "required": ["caseId", "durationBucket", "hintUsed"], "meaning": "Case was left through an observed transition; not all exits are observable." },
    "session_completed": { "cardinality": "once/session", "required": ["durationBucket"], "meaning": "Configured plan completed; distinct from overall game completion." },
    "case_quality_assessed": { "cardinality": "once/case", "required": ["caseId", "selectedClassification", "referenceClassification", "classificationMatch", "selectedMeasure", "selectedActor", "evidenceQuality", "decisionQuality", "reasoningQuality", "viewedEvidenceBand", "citedEvidenceBand", "omittedRelevantBand", "contradictoryEvidenceRecognized", "revisionOccurred", "revisionCountBand", "revisionDirection"], "meaning": "Schema 2 bounded game-derived quality indicators; not efficacy, legal competence or critical thinking." },
    "decision_revised": { "cardinality": "once/case", "required": ["caseId", "revisionCountBand", "revisionDirection"], "meaning": "Schema 2 bounded revision summary." },
    "accessibility_used": { "cardinality": "once/session", "required": ["accessibilitySetting"], "meaning": "Schema 2 accessibility feature used; not a disability inference." },
    "interface_error": { "cardinality": "action", "required": ["errorCode"], "optional": ["caseId"], "meaning": "Schema 2 closed technical error category; no message or stack." },
    "evidence_opened": { "cardinality": "action-deduplicated/index", "required": ["caseId"], "meaning": "A valid evidence item was opened; item index is not transmitted." },
    "evidence_cited": { "cardinality": "action-deduplicated/index", "required": ["caseId"], "meaning": "A valid evidence item was cited; content and index are not transmitted." },
    "citation_error": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Game detected a citation error; not a competence measure." },
    "hint_requested": { "cardinality": "action", "required": ["caseId"], "meaning": "Hint requested; may repeat." },
    "decision_submitted": { "cardinality": "once/case", "required": ["caseId"], "optional": ["hintUsed"], "meaning": "Decision submitted; decision content is excluded." },
    "report_signed": { "cardinality": "once/case", "required": ["caseId", "result"], "optional": ["hintUsed"], "meaning": "Report signed; report content is excluded." },
    "tutorial_started": { "cardinality": "once/case", "required": ["caseId", "tutorialVersion"], "meaning": "Tutorial started." },
    "tutorial_skipped": { "cardinality": "once/case", "required": ["caseId", "tutorialVersion"], "meaning": "Tutorial skipped." },
    "tutorial_completed": { "cardinality": "once/case", "required": ["caseId", "tutorialVersion"], "meaning": "Tutorial flow completed; does not prove comprehension." },
    "debrief_opened": { "cardinality": "once/case", "required": ["caseId", "result"], "meaning": "Debrief opened; does not prove reading or learning." },
    "review_started": { "cardinality": "once/session", "required": [], "meaning": "Review mode entered." },
    "clues_selected": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Clue-selection step completed; selections are excluded." },
    "classification_selected": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Classification step completed; selected value is excluded." },
    "measure_selected": { "cardinality": "once/case", "required": ["caseId"], "meaning": "Measure step completed; selected value is excluded." },
    "case_result": { "cardinality": "once/case", "required": ["caseId", "result"], "meaning": "Legacy alias normalized by the client to case_completed; backend rejects this event in incoming batches." },
    "norm_unlocked": { "cardinality": "once/case", "required": [], "optional": ["caseId"], "meaning": "Norm reference unlocked." },
    "archive_opened": { "cardinality": "action", "required": [], "meaning": "Archive opened." },
    "ending_reached": { "cardinality": "once/session", "required": [], "meaning": "An ending was reached; ending identity is excluded." },
    "game_completed": { "cardinality": "once/session", "required": [], "meaning": "Overall game completion; distinct from plan completion." },
    "credits_opened": { "cardinality": "action", "required": [], "meaning": "Credits opened." },
    "reset_game": { "cardinality": "action", "required": [], "meaning": "Local game reset action." },
    "pageview": { "cardinality": "action-deduplicated/phase", "required": [], "meaning": "Supported phase became current; not a web unique pageview." }
  },
  "missingValuePolicy": {
    "absentRow": "unavailable_not_zero",
    "suppression": "daily cells with count below 10 are omitted before sums",
    "zeroDenominator": "not_calculable",
    "unknownOrExtraField": "reject"
  },
  "retention": { "countersDaysInclusive": 90, "receiptHours": 24, "basis": "UTC receipt time" }
}

